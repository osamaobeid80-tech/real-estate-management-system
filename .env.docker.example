# ============================================
# متغيرات بيئة Docker Compose — انسخ هذا الملف إلى .env.docker وعدّل القيم قبل التشغيل
# الاستخدام: docker compose --env-file .env.docker up -d --build
# ============================================

# --- قاعدة البيانات PostgreSQL ---
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD
DB_HOST_PORT=5432

# --- Backend (Node.js + Express + JWT) ---
# سرّ توقيع JWT - يجب أن يكون نصًا عشوائيًا طويلاً وسريًا تمامًا
# توليد قيمة قوية: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_VALUE
JWT_EXPIRES_IN=8h
# رابط الواجهة المسموح لها بالاتصال بالـ API (نفس منفذ FRONTEND_HOST_PORT أدناه)
CORS_ORIGIN=http://localhost:8080
BACKEND_HOST_PORT=4000

# --- الواجهة الأمامية (React عبر Nginx) ---
FRONTEND_HOST_PORT=8080
