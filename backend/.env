# ============================================
# نسخ هذا الملف إلى .env وتعديل القيم قبل التشغيل
# ============================================

# منفذ تشغيل الخادم
PORT=4000

# رابط الاتصال بقاعدة بيانات PostgreSQL
# مثال محلي: postgresql://postgres:yourpassword@localhost:5432/real_estate_db
# مثال استضافة سحابية (Render/Railway/Neon): يُنسخ مباشرة من لوحة تحكم الخدمة
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/real_estate_db

# سرّ توليد وتوثيق JWT - يجب أن يكون نصًا عشوائيًا طويلاً وسريًا تمامًا
# يمكن توليد قيمة قوية عبر: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_VALUE

# مدة صلاحية رمز الدخول
JWT_EXPIRES_IN=8h

# النطاق المسموح له بالاتصال بالـ API من المتصفح (رابط الواجهة الأمامية)
CORS_ORIGIN=http://localhost:5500
